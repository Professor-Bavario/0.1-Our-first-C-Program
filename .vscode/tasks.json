{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (MSYS2)",
            "type": "process",
            "command": "gcc",
            "args": [
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/../${fileBasenameNoExtension}.exe"
            ],
            "problemMatcher": ["$gcc"],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "C:/msys64/mingw64/bin;${env:PATH}"
                }
            }
        },
        {
            "label": "Build (Linux)",
            "type": "process",
            "command": "gcc",
            "args": [
              "-g",
              "${file}",
              "-o",
              "${fileDirname}/../${fileBasenameNoExtension}"
            ],
            "problemMatcher": ["$gcc"]
        }
    ]
}